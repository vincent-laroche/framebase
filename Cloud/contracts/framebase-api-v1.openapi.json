{
  "openapi": "3.1.0",
  "info": {
    "title": "Framebase Development API",
    "version": "1.2.0",
    "description": "Private development cloud contract for Framebase Phase 4 organization and recovery."
  },
  "paths": {
    "/v1/health": {
      "get": {
        "summary": "Public liveness"
      }
    },
    "/v1/capabilities": {
      "get": {
        "summary": "Authenticated version capabilities",
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/v1/auth/enroll": {
      "post": {
        "summary": "Development device enrollment",
        "parameters": [
          {
            "name": "X-Enrollment-Secret",
            "in": "header",
            "required": true
          }
        ]
      }
    },
    "/v1/auth/enroll/challenge": {
      "post": {
        "summary": "Issue a one-time device keypair enrollment challenge"
      }
    },
    "/v1/auth/enroll/complete": {
      "post": {
        "summary": "Verify a device keypair enrollment proof"
      }
    },
    "/v1/auth/revoke": {
      "post": {
        "summary": "Revoke a temporary development device",
        "parameters": [
          {
            "name": "X-Enrollment-Secret",
            "in": "header",
            "required": true
          }
        ]
      }
    },
    "/v1/catalog/bootstrap": {
      "get": {
        "summary": "Paginated catalog bootstrap",
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/v1/changes": {
      "get": {
        "summary": "Ordered exclusive change feed",
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/v1/blobs/upload-initiate": {
      "post": {
        "summary": "Initiate a signed direct fixture upload",
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/v1/blobs/upload-complete": {
      "post": {
        "summary": "Verify an uploaded fixture blob",
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/v1/blobs/multipart/initiate": {
      "post": {
        "summary": "Create or resume a private multipart original upload",
        "security": [{ "bearerAuth": [] }]
      }
    },
    "/v1/blobs/multipart/{uploadId}/parts/{partNumber}": {
      "put": {
        "summary": "Upload one bounded authenticated multipart part",
        "security": [{ "bearerAuth": [] }]
      }
    },
    "/v1/blobs/multipart/{uploadId}/complete": {
      "post": {
        "summary": "Assemble a complete multipart original privately in R2",
        "security": [{ "bearerAuth": [] }]
      }
    },
    "/v1/blobs/multipart/{uploadId}/confirm": {
      "post": {
        "summary": "Accept device checksum verification of a completed multipart original",
        "security": [{ "bearerAuth": [] }]
      }
    },
    "/v1/blobs/{id}/verification-download": {
      "get": {
        "summary": "Issue a short-lived verification-only private download",
        "security": [{ "bearerAuth": [] }]
      }
    },
    "/v1/assets/{id}/variants/{variant}": {
      "get": {
        "summary": "Return one fixed private cloud derivative variant",
        "security": [{ "bearerAuth": [] }]
      }
    },
    "/v1/blobs/{id}/download": {
      "get": {
        "summary": "Issue a signed direct download",
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/v1/mutations": {
      "post": {
        "summary": "Apply idempotent revisioned catalog mutations",
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code",
              "message",
              "requestId"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "requestId": {
                "type": "string"
              }
            }
          }
        }
      },
      "ChangeEvent": {
        "type": "object",
        "required": [
          "revision",
          "entityType",
          "entityId",
          "operation",
          "payload",
          "actorId",
          "createdAt"
        ],
        "properties": {
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "entityType": {
            "enum": [
              "asset",
              "folder",
              "album",
              "blob",
              "tag",
              "saved_search",
              "export_receipt",
              "backup_manifest"
            ]
          },
          "entityId": {
            "type": "string"
          },
          "operation": {
            "type": "string"
          },
          "payload": {
            "type": "object"
          },
          "actorId": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "AgentScope": {
        "type": "string",
        "enum": [
          "library.read",
          "assets.metadata.write",
          "assets.organize",
          "intelligence.run",
          "workflows.run",
          "exports.read"
        ],
        "description": "Preview-only Phase 8 scope vocabulary. Remote identities and endpoints are not deployed."
      },
      "AgentOperationKind": {
        "type": "string",
        "enum": [
          "searchAssets",
          "getAsset",
          "getMetadata",
          "listFolders",
          "createFolder",
          "moveAssets",
          "renameAsset",
          "setRating",
          "addTags",
          "addToAlbum",
          "runOCR",
          "analyzeAssets",
          "runWorkflow",
          "getOperation",
          "downloadOriginal",
          "exportAssets",
          "diagnostics"
        ],
        "description": "Supported Phase 8 operation vocabulary. Permanent purge, arbitrary SQL, raw storage access, and credential operations are intentionally absent."
      },
      "AgentOperationRequest": {
        "type": "object",
        "required": [
          "id",
          "operation",
          "targetAssetIds",
          "catalogRevision"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "operation": {
            "$ref": "#/components/schemas/AgentOperationKind"
          },
          "targetAssetIds": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "uniqueItems": true
          },
          "catalogRevision": {
            "type": "integer",
            "minimum": 0
          },
          "parameters": {
            "type": "object",
            "additionalProperties": false,
            "description": "Operation-specific values. Adapters must not log these values."
          }
        },
        "additionalProperties": false,
        "description": "Preview-only schema. A mutation is proposal-first and cannot apply without a matching approval token."
      },
      "AgentApprovalToken": {
        "type": "object",
        "required": [
          "id",
          "operationId",
          "targetAssetIds",
          "catalogRevision",
          "expiresAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "operationId": {
            "type": "string",
            "format": "uuid"
          },
          "targetAssetIds": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "uniqueItems": true
          },
          "catalogRevision": {
            "type": "integer",
            "minimum": 0
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "additionalProperties": false,
        "description": "Binds a human approval to one exact reviewed operation, target set, and catalog revision."
      },
      "MutationOperation": {
        "type": "object",
        "required": [
          "type",
          "targetId",
          "payload"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "create_folder",
              "rename_folder",
              "move_folder",
              "create_asset",
              "move_asset",
              "move_assets",
              "update_rating",
              "update_favorite",
              "create_album",
              "add_assets_to_album",
              "create_tag",
              "rename_tag",
              "delete_tag",
              "add_tag_to_assets",
              "remove_tag_from_assets",
              "create_saved_search",
              "update_saved_search",
              "delete_saved_search",
              "record_export_receipt",
              "record_backup_manifest",
              "record_backup_restore_drill",
              "rename_asset",
              "trash_asset",
              "restore_asset",
              "rename_album",
              "remove_assets_from_album",
              "reorder_album",
              "delete_album"
            ]
          },
          "targetId": {
            "type": "string"
          },
          "baseRevision": {
            "type": "integer",
            "minimum": 0
          },
          "payload": {
            "type": "object"
          }
        }
      }
    }
  }
}
